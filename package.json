{
  "name": "quick-delivery",
  "private": true,
  "version": "0.1.0",
  "description": "Intracity bike quick-delivery platform: backend, web (admin, business, tracking, onboarding) and Flutter apps (driver, business)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:backend": "pnpm --filter @qd/backend start:dev",
    "dev:web": "pnpm --filter @qd/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @qd/backend test",
    "db:migrate": "pnpm --filter @qd/backend prisma:migrate",
    "db:seed": "pnpm --filter @qd/backend seed"
  }
}
