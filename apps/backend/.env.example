# Copy to .env
DATABASE_URL=postgresql://qd:qd@localhost:5432/quickdelivery
PORT=4000
NODE_ENV=development
# Long random strings in production
JWT_SECRET=change-me-jwt
# 32+ chars, used to encrypt OTPs and bank account numbers at rest (AES-256-GCM)
DATA_ENCRYPTION_KEY=change-me-to-a-32-plus-char-secret-key!!
# Base URL of the web app (tracking links, onboarding links)
PUBLIC_WEB_URL=http://localhost:3000
# CORS origins, comma separated
CORS_ORIGINS=http://localhost:3000
# Providers: console (dev) — plug real SMS/WhatsApp/payment providers in src/notifications and src/wallet
SMS_PROVIDER=console
PAYMENT_PROVIDER=mock
# Razorpay (when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Document storage dir (private; served only through signed, expiring URLs)
UPLOAD_DIR=./uploads
# Operational timings (seconds / minutes)
OFFER_TIMEOUT_SECONDS=30
ASSIGNMENT_MAX_RIDERS=5
ASSIGNMENT_MAX_SECONDS=180
ARRIVAL_WAIT_MINUTES=15
ONBOARDING_LINK_HOURS=48
# Dev only: echo login OTPs in API responses so you can test without SMS
DEV_ECHO_OTP=true
